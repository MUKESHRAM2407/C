#include <stdio.h>
int main()
{
    int a;
    printf("Enter the temperature : ");
    scanf("%d",&a);
    
    if(a<0)
    {
        printf("Freezing weather");
    }
    else if(a>=0 && a<10)
    {
        printf("Very Cold Weather");
    }
    else if(a>=10 && a<20)
    {
        printf("Cold Weather");
    }
    else if(a>=20 && a<30)
    {
        printf("Normal in Temp");
    }
    else if(a>=30 && a<40)
    {
        printf("Its hot");
    }
    else if(a>=40)
    {
        printf("Its Very Hot");
    }
    return 0;
}
