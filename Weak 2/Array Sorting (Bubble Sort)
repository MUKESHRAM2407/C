//Sort the array in asending order
#include<stdio.h>
int main()
{
	int i,a[10],j,temp;
	printf("Enter the array elements ");
	for(i=0;i<10;i++)
	{
		scanf("%d ",&a[i]);
	}
	for(i=0;i<10;i++)
	{
		for(j=0;j<10;j++)
		{
			if(a[j] > a[j+1])
			{
				temp=a[j];
				a[j]=a[j+1];
				a[j+1]=temp;
			}
		}
	}
	for(i=0;i<10;i++)
	{
		printf("%d ",a[i]);
	}
	return 0; //sorting done by Bubblesort
}
