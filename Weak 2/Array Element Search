//	Element is present or not
#include<stdio.h>
int main()
{
	int x,a[10],i,y;
	printf("Enter the array elements ");
	for(i=0;i<10;i++)
	{
		scanf("%d ",&a[i]);
	}
	printf("\n Enter the element to be search");
	scanf("%d",&x);
	for(i=0;i<10;i++)
	{	
		y=0;
		if(x==a[i])
		{
			y=1;
			break;
		}
	}
	if(y==0)
	{
		printf("Element is not present");
	}
	else
	{
		printf("Element is present");
	}
	return 0;
}
