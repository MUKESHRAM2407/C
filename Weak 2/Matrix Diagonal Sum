//Sum of primary diagonal elements of an matrix
#include<stdio.h>
int main()
{
	int a[3][3],s,i,j;
	printf("Enter the matrix elements ");
	for(i=0;i<3;i++)
	{
		for(j=0;j<3;j++)
		{
			scanf("%d ",&a[i][i]);
		}
	}
	s=0;
	for(i=0;i<3;i++)
	{
		for(j=0;j<3;j++)
		{
			if(i==j)
			{
				s=s+a[i][j];
			}
		} 
    }
	printf("The sum of diagonal element is %d",s);
	return 0; 
}
