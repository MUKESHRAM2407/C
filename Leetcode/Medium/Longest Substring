#include <stdio.h>
#include <string.h>

int lengthOfLongestSubstring(char* s) {
    int n = strlen(s);
    if (n == 0) return 0;

    // Array to store the last seen index of each character (ASCII size 128)
    // Initialize all elements to -1
    int last_seen[128];
    for (int i = 0; i < 128; i++) {
        last_seen[i] = -1;
    }

    int max_length = 0;
    int start = 0; // Left pointer of the sliding window

    for (int end = 0; end < n; end++) {
        char current_char = s[end];

        // If the character was seen inside the current window, move the start pointer
        if (last_seen[(unsigned char)current_char] >= start) {
            start = last_seen[(unsigned char)current_char] + 1;
        }

        // Update the last seen position of the character
        last_seen[(unsigned char)current_char] = end;

        // Calculate the current window length and update max_length
        int current_length = end - start + 1;
        if (current_length > max_length) {
            max_length = current_length;
        }
    }

    return max_length;
}
