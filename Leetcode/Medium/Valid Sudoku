#include <stdbool.h>

bool isValidSudoku(char** board, int boardSize, int* boardColSize)
{
    int row[9][10] = {0};
    int col[9][10] = {0};
    int box[9][10] = {0};

    int i, j, num, boxIndex;

    for (i = 0; i < 9; i++)
    {
        for (j = 0; j < 9; j++)
        {
            if (board[i][j] == '.')
                continue;

            num = board[i][j] - '0';
            boxIndex = (i / 3) * 3 + (j / 3);

            if (row[i][num] == 1)
                return false;

            if (col[j][num] == 1)
                return false;

            if (box[boxIndex][num] == 1)
                return false;

            row[i][num] = 1;
            col[j][num] = 1;
            box[boxIndex][num] = 1;
        }
    }

    return true;
}
