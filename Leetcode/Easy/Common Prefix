#include <stdio.h>
#include <string.h>

char* longestCommonPrefix(char** strs, int strsSize) {
    static char result[201];
    int i, j;

    strcpy(result, strs[0]);

    for (i = 1; i < strsSize; i++) {
        j = 0;

        while (result[j] != '\0' &&
               strs[i][j] != '\0' &&
               result[j] == strs[i][j]) {
            j++;
        }

        result[j] = '\0';

        if (result[0] == '\0') {
            return result;
        }
    }

    return result;
}
