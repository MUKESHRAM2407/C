#include <stdlib.h>

int* intersection(int* nums1, int nums1Size,
                  int* nums2, int nums2Size,
                  int* returnSize)
{
    int present[1001] = {0};
    int used[1001] = {0};

    for (int i = 0; i < nums1Size; i++)
    {
        present[nums1[i]] = 1;
    }

    int *result = (int*)malloc(1001 * sizeof(int));
    int count = 0;

    for (int i = 0; i < nums2Size; i++)
    {
        if (present[nums2[i]] && !used[nums2[i]])
        {
            result[count++] = nums2[i];
            used[nums2[i]] = 1;
        }
    }

    *returnSize = count;

    return result;
}
