int romanToInt(char* s)
{
    int value(char c)
    {
        if (c == 'I')
            return 1;
        if (c == 'V')
            return 5;
        if (c == 'X')
            return 10;
        if (c == 'L')
            return 50;
        if (c == 'C')
            return 100;
        if (c == 'D')
            return 500;
        if (c == 'M')
            return 1000;

        return 0;
    }

    int result = 0;
    int i;

    for (i = 0; s[i] != '\0'; i++)
    {
        if (value(s[i]) < value(s[i + 1]))
            result = result - value(s[i]);
        else
            result = result + value(s[i]);
    }

    return result;
}
