/* To find given string is pallidrome or not*/
#include<stdio.h> 
#include<string.h>

int main()
{
	char s1[50],s2[50];
	int i,l;
	printf("Enter the string ");
	scanf("%s",s1);
	l=strlen(s1);
	for(i=0;i<l;i++)
	{
		s2[i]=s1[l-1-i];
	}
	s2[l]='\0';
	if(strcmp(s1,s2)==0)
	{
		printf("Given string is pallidrome");
	}
	else
	{
		printf("Given string is not a pallidrome");
	}
	return 0;
}
